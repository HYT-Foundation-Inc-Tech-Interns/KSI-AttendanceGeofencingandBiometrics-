# Copy to .env and fill in. `.env` is gitignored; never commit real values.
#
#   cp .env.example .env

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=v1
LOG_LEVEL=debug
# Request body limit. Check-in sends a base64 face image inside the JSON body,
# so the Express default of 100 kB rejects a real phone photo.
BODY_LIMIT=10mb

# --- database --------------------------------------------------------------
# Postgres with PostGIS. Geofencing uses ST_DWithin / ST_Distance, so plain
# Postgres will fail at runtime.
DATABASE_URL=postgresql://user:password@host:5432/database

# --- auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- cors ------------------------------------------------------------------
# Comma-separated origins, no trailing slash. The browser blocks cross-origin
# API calls and `credentials: true` rules out a wildcard.
CORS_ORIGINS=http://localhost:3002

# --- geofencing / biometrics -----------------------------------------------
# Geofence is enforced in PostGIS and costs nothing -- keep this false.
DEV_SKIP_GEOFENCE_VALIDATION=false

# Face verification. Leave "true" until a matcher is configured: BiometricService
# picks its backend at construction (AWS Rekognition > InsightFace > none), and
# with none configured verifyFace() throws and EVERY check-in returns 401.
DEV_SKIP_BIOMETRIC_VERIFICATION=true

FACE_MATCH_THRESHOLD=0.85
LIVENESS_THRESHOLD=0.7
MAX_GEOFENCE_DISTANCE_M=1000
MAX_TIMESTAMP_DRIFT_SEC=300
MAX_SHIFT_HOURS=16

# --- optional face matchers (both cost money; neither is required) ---------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# FACE_MATCH_SERVICE_URL=

# --- email delivery --------------------------------------------------------
# Any SMTP provider works. For Gmail: enable 2-Step Verification, then create
# an App Password at myaccount.google.com -> Security -> App passwords. Paste
# the 16 characters with the spaces removed.
#
# Gmail App Passwords are revoked automatically when the account password
# changes, which shows up here as "535-5.7.8 Username and Password not
# accepted". If that happens, generate a new App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Klassic Attendance <you@example.com>

# Public check-in page, linked from the welcome email.
APP_CHECKIN_URL=http://localhost:3002/checkin

# --- signing / encryption --------------------------------------------------
HMAC_DEVICE_SIGNING_KEY=
ENCRYPTION_KEY=

# --- rate limiting ---------------------------------------------------------
# Applied globally. Auth routes tighten this further with @Throttle.
RATE_LIMIT=100

# --- retention -------------------------------------------------------------
BIOMETRIC_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# --- feature flags ---------------------------------------------------------
ENABLE_OFFLINE_SYNC=true
ENABLE_MOCK_LOCATION_DETECTION=true
ENABLE_ROOT_JAILBREAK_DETECTION=true
ENABLE_PAYROLL_AUTO_EXPORT=false
