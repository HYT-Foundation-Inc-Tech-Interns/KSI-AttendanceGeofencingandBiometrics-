# Klassic Field Attendance System - .gitignore

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local

# Vault secrets
secrets/
*.key
*.pem
*.p12
*.jks

# =============================================================================
# NODE / NPM
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Coverage
coverage/
*.lcov
.nyc_output/

# =============================================================================
# EXPO / REACT NATIVE
# =============================================================================
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*
web-build/

# Metro
.metro-health-check*

# =============================================================================
# DATABASE
# =============================================================================
*.sqlite
*.sqlite3
*.db

# Local PostgreSQL data
postgres-data/
pgdata/

# =============================================================================
# LOGS
# =============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# =============================================================================
# EDITORS & IDEs
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# TESTING
# =============================================================================
.jest/
junit.xml
test-results/

# =============================================================================
# DOCKER
# =============================================================================
docker-compose.override.yml
.dockerignore

# =============================================================================
# COMPLIANCE & SENSITIVE DOCS
# =============================================================================
# Signed contracts, DPAs, and consent forms should NOT be in repo
docs/compliance/signed/
docs/compliance/vendor-dpa-signed/
docs/compliance/employee-consents/
docs/compliance/*.pdf
docs/compliance/*.docx

# Exception: templates are OK
!docs/compliance/*-template.md
!docs/compliance/*-template.docx

# =============================================================================
# BIOMETRIC DATA (NEVER COMMIT!)
# =============================================================================
# Face embeddings, enrollment photos, test biometric data
embeddings/
biometric-data/
face-data/
enrollment-photos/
*.embedding
*.face

# =============================================================================
# BACKUPS
# =============================================================================
*.backup
*.bak
*.dump
*.sql.gz

# =============================================================================
# TEMPORARY FILES
# =============================================================================
tmp/
temp/
*.tmp
*.cache

# =============================================================================
# OS SPECIFIC
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# =============================================================================
# CERTIFICATES (DEV ONLY)
# =============================================================================
# Self-signed certs for local dev - never commit production certs!
*.crt
*.cer
*.der

# =============================================================================
# SENTRY & ERROR TRACKING
# =============================================================================
.sentryclirc

# =============================================================================
# MISC
# =============================================================================
.lock-wscript
.npm
.eslintcache
.stylelintcache
.cache/

# Nested Create-Next-App scaffold repo, set aside so the dashboard is tracked
# as normal files in this single repository. Rename back to dashboard/.git to
# restore it as a standalone repo.
.git-scaffold-backup/

# =============================================================================
# LOCAL SCRATCH
# =============================================================================
# WorkBuddy project data (local memory logs). Not part of the deliverable.
.workbuddy-ai/

# Throwaway static file server for opening the built dashboard/out over a
# tunnel on a phone. `next dev` is the normal development path.
_serve-out.mjs

# One-command bring-up for the demo stack (backend + static server + two
# Cloudflare quick tunnels). Hardcodes local binary paths, so it stays local.
_stack-up.sh

# Headless-browser smoke check that logs in and screenshots the deployed app.
# Needs the Playwright cache and local binary paths, so it stays local.
_render-check.*

# Paste-ready environment block for the Render dashboard, generated from
# backend/.env. CONTAINS LIVE SECRETS -- never commit this.
_render-env.txt

# Probes which Supabase pooler region the project belongs to. Reads
# backend/.env at runtime, so it stays local alongside the other diagnostics.
backend/_pooler-check.mjs

# Diagnostic screenshots captured while verifying the map and face overlays.
map-faces-*.png
