# Klassic Field Attendance System - Mobile App Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_BASE_URL=http://localhost:3000/v1

# Production
# API_BASE_URL=https://api.klassic.ph/v1

# Staging
# API_BASE_URL=https://staging-api.klassic.ph/v1

# =============================================================================
# APP CONFIGURATION
# =============================================================================
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# =============================================================================
# BIOMETRIC CONFIGURATION
# =============================================================================
# Liveness detection threshold (0-1)
LIVENESS_THRESHOLD=0.7

# Minimum confidence for face detection
FACE_DETECTION_CONFIDENCE=0.8

# =============================================================================
# GEOFENCING
# =============================================================================
# GPS accuracy threshold (meters) - reject readings with worse accuracy
GPS_ACCURACY_THRESHOLD_M=50

# Client-side pre-check geofence buffer (meters) for UX feedback
# Server still validates authoritatively
GEOFENCE_BUFFER_M=20

# =============================================================================
# OFFLINE SYNC
# =============================================================================
# Maximum number of offline events to queue before warning user
MAX_OFFLINE_QUEUE_SIZE=100

# Retry interval for failed sync attempts (seconds)
SYNC_RETRY_INTERVAL_SEC=60

# Maximum sync retry attempts before flagging for manual review
MAX_SYNC_RETRY_ATTEMPTS=5

# =============================================================================
# ERROR TRACKING
# =============================================================================
SENTRY_DSN=https://your-mobile-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_DEV_MENU=true
ENABLE_OFFLINE_MODE=true
ENABLE_BIOMETRIC_CACHE=true

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# Use mock location data (for testing without GPS)
DEV_MOCK_LOCATION=false
DEV_MOCK_LAT=14.5964
DEV_MOCK_LNG=120.9842

# Skip biometric verification (for UI testing)
DEV_SKIP_BIOMETRIC=false

# Use mock face embeddings (for testing without camera)
DEV_MOCK_FACE_EMBEDDING=false
