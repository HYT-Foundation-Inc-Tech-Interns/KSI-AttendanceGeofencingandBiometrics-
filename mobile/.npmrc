# `@testing-library/react-native` pulls in `react-test-renderer`, whose peer range
# is `react@^19.3.0`, while this app pins `react@18.2.0` to match Expo SDK 50.
# Without this flag every `npm install` in this directory fails with ERESOLVE
# before it installs anything -- including `npx expo install`.
legacy-peer-deps=true
